PORT=8080
APP_ENV=development

# Database Configuration (PostgreSQL or SQLite)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lms_db
DB_SSLMODE=disable
DB_SQLITE_PATH=./lms.db

# Authentication
JWT_SECRET=lms-super-secure-production-jwt-key-32chars
JWT_EXPIRY_HOURS=24

# LiveKit (WebRTC Meeting Rooms)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Storage
UPLOAD_DIR=./uploads

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
