# ==============================================================================
# LMS Root Environment Configuration Example
# ==============================================================================

# Backend Server Configuration
PORT=8080
APP_ENV=development
JWT_SECRET=super-secret-jwt-key-change-in-production

# Database Configuration (PostgreSQL default, falls back to SQLite if empty)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lms
DB_SSLMODE=disable

# LiveKit WebRTC Configuration
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Frontend Configuration
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NUXT_PUBLIC_WS_URL=ws://localhost:8080/ws
